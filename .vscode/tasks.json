{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": "$tsc",
			"label": "npm: compile"
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"label": "npm: watch"
		},
		{
			"label": "run tests",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"E:\\repo\\EWW\\.test.cmd"
			],
			"isBackground": false
		},
		{
			"label": "release 1.1.8",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"E:\\repo\\EWW\\.rel.cmd"
			],
			"isBackground": false
		}
	]
}