{
  "name": "eww-bridge",
  "displayName": "EWW Bridge — Copilot Chat to Feishu / Lark",
  "description": "Stream your active VS Code Copilot Chat session to a Feishu/Lark card in real time, and send new tasks from Feishu back into the same chat session.",
  "version": "1.1.5",
  "publisher": "huangdan",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruak/EWW-bridge"
  },
  "homepage": "https://github.com/Ruak/EWW-bridge#readme",
  "bugs": {
    "url": "https://github.com/Ruak/EWW-bridge/issues"
  },
  "keywords": [
    "copilot",
    "chat",
    "feishu",
    "lark",
    "bridge",
    "remote",
    "agent",
    "notification"
  ],
  "galleryBanner": {
    "color": "#1E3FAE",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ewwBridge.setCredentials",
        "title": "%command.setCredentials%"
      },
      {
        "command": "ewwBridge.connect",
        "title": "%command.connect%"
      },
      {
        "command": "ewwBridge.disconnect",
        "title": "%command.disconnect%"
      },
      {
        "command": "ewwBridge.showStatus",
        "title": "%command.showStatus%"
      },
      {
        "command": "ewwBridge.testSend",
        "title": "%command.testSend%"
      },
      {
        "command": "ewwBridge.setDefaultChat",
        "title": "%command.setDefaultChat%"
      },
      {
        "command": "ewwBridge.showLogs",
        "title": "%command.showLogs%"
      },
      {
        "command": "ewwBridge.dumpCurrentSession",
        "title": "%command.dumpCurrentSession%"
      },
      {
        "command": "ewwBridge.followLatestSession",
        "title": "%command.followLatestSession%"
      },
      {
        "command": "ewwBridge.injectTest",
        "title": "%command.injectTest%"
      },
      {
        "command": "ewwBridge.patchCopilotFlush",
        "title": "%command.patchCopilotFlush%"
      },
      {
        "command": "ewwBridge.restoreCopilotFlush",
        "title": "%command.restoreCopilotFlush%"
      },
      {
        "command": "ewwBridge.compatCheck",
        "title": "%command.compatCheck%"
      }
    ],
    "configuration": {
      "title": "EWW Bridge",
      "properties": {
        "ewwBridge.copilotExtensionFile": {
          "type": "string",
          "default": "",
          "description": "%config.copilotExtensionFile%"
        },
        "ewwBridge.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "ewwBridge.feishu.appId": {
          "type": "string",
          "default": "",
          "description": "%config.feishu.appId%"
        },
        "ewwBridge.feishu.defaultChatId": {
          "type": "string",
          "default": "",
          "description": "%config.feishu.defaultChatId%"
        },
        "ewwBridge.forward.userMessages": {
          "type": "boolean",
          "default": true,
          "description": "%config.forward.userMessages%"
        },
        "ewwBridge.forward.assistantMessages": {
          "type": "boolean",
          "default": true,
          "description": "%config.forward.assistantMessages%"
        },
        "ewwBridge.forward.toolCalls": {
          "type": "boolean",
          "default": false,
          "description": "%config.forward.toolCalls%"
        },
        "ewwBridge.forward.progress": {
          "type": "boolean",
          "default": true,
          "description": "%config.forward.progress%"
        },
        "ewwBridge.forward.thinking": {
          "type": "boolean",
          "default": false,
          "description": "%config.forward.thinking%"
        },
        "ewwBridge.forward.streaming": {
          "type": "boolean",
          "default": true,
          "description": "%config.forward.streaming%"
        },
        "ewwBridge.forward.streamingIntervalMs": {
          "type": "number",
          "default": 500,
          "description": "%config.forward.streamingIntervalMs%"
        },
        "ewwBridge.forward.patchStreamText": {
          "type": "boolean",
          "default": true,
          "description": "%config.forward.patchStreamText%"
        },
        "ewwBridge.forward.idleMs": {
          "type": "number",
          "default": 2500,
          "description": "%config.forward.idleMs%"
        },
        "ewwBridge.security.allowedOpenIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.security.allowedOpenIds%"
        },
        "ewwBridge.security.prefix": {
          "type": "string",
          "default": "",
          "description": "%config.security.prefix%"
        },
        "ewwBridge.inject.newChat": {
          "type": "boolean",
          "default": false,
          "description": "%config.inject.newChat%"
        },
        "ewwBridge.inject.timeoutMs": {
          "type": "number",
          "default": 900000,
          "description": "%config.inject.timeoutMs%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "node test/card.js && node test/parser.js && node test/transcript.js && node test/transcript-session-id.js && node test/agent-task-complete.js && node test/copilot-patch.js && node test/copilot-anchors.js && node test/compat.js && node test/nls.js && node test/smoke.js && node test/replay-floor.js && node test/partial.js && node test/instance.js && node test/activate.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.7.0"
  }
}
